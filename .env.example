# PostgreSQL connection string from your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SQLITE_SOURCE_PATH=project.db

# Cloudinary credentials are read only by the server; never rename them to VITE_*.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sonrisetalk

# Gemini credentials are read only by the server; never rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=

# Web Push keys for background incoming-call alerts. Keep the private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Generate with `npm run admin:hash`; keep this server-side and private.
ADMIN_PROMOTION_PASSWORD_HASH=

# Local API settings. Set VITE_API_URL to your deployed API origin in production.
VITE_API_URL=http://localhost:3001
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
SOCKET_CLIENT_URLS=http://localhost:5173,http://localhost:4173

# Configure a production STUN/TURN service for calls across restrictive networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_LIFETIME_SECONDS=3600
